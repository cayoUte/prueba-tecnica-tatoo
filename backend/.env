# =============================================================================
#  CREDENCIALES DE DEMO - EXPUESTAS A PROPOSITO
# =============================================================================
#  Este archivo esta versionado para que la prueba se pueda ejecutar con un
#  `git clone` y nada mas: sin copiar .env.example, sin generar APP_KEY y sin
#  registrarse en OpenWeatherMap para conseguir una clave propia.
#
#  Es una decision consciente para facilitar la revision, no un descuido.
#  En un proyecto real este archivo NO se versiona: las claves irian en el
#  gestor de secretos del entorno y aqui solo quedaria .env.example.
#
#  Lo que queda expuesto y sus consecuencias:
#    - OPENWEATHER_KEY: plan gratuito, solo lectura del clima. Si se abusa,
#      se agota la cuota. Se rota cuando termine la evaluacion.
#    - APP_KEY: firma las cookies de sesion. Sirve para este entorno local;
#      cualquier despliegue real debe generar la suya con `key:generate`.
# =============================================================================

APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:j+tI3cz/Qm7XGYVY31c4BxYrUo0ACsMcPwvv30ulNOU=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SPA de React + Vite (CORS y dominios stateful de Sanctum)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# OpenWeatherMap
OPENWEATHER_KEY=8e1af102dd23f85eb45ccc0708dc71a3
OPENWEATHER_URL=https://api.openweathermap.org/data/2.5

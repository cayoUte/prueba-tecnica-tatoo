# ─── Entorno ─────────────────────────────────────────────
.env
.env.*
!.env.example
# backend/.env se versiona a proposito: lleva credenciales de demo para que
# la prueba se pueda ejecutar sin registrarse en OpenWeatherMap. Ver el
# README, seccion "Las credenciales estan en el repositorio a proposito".
!backend/.env

# ─── Dependencias ────────────────────────────────────────
node_modules/
vendor/

# ─── Base de datos local (se regenera con artisan migrate) ───
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# ─── Builds ──────────────────────────────────────────────
dist/
backend/public/build/
backend/public/hot/
backend/public/storage

# ─── Caché, logs y cobertura ─────────────────────────────
*.log
.phpunit.result.cache
.phpunit.cache/
coverage/
backend/storage/*.key

# ─── Editores y sistema operativo ────────────────────────
.vscode/
.idea/
.zed/
.claude/
*.swp
.DS_Store
Thumbs.db
desktop.ini